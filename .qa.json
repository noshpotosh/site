{
  "version": 1,
  "profile": "static-site",
  "integrationBranch": "main",
  "agent": "codex",
  "thresholds": {
    "warnLines": 400,
    "warnFiles": 20,
    "exceptionLines": 800
  },
  "paths": {
    "generated": [
      "dist/**",
      "build/**",
      "**/package-lock.json",
      "**/uv.lock",
      "**/Cargo.lock"
    ],
    "vendor": [
      "vendor/**",
      "node_modules/**"
    ],
    "captures": [
      "captures/**"
    ],
    "ui": [
      "**/*.html",
      "**/*.css",
      "**/*.js",
      "**/*.svg"
    ],
    "realtime-systems": [
      "src/**",
      "server/**",
      "tests/**"
    ],
    "asset-pipeline": [
      "assets/**",
      "exports/**",
      "renders/**",
      "cad/**",
      "kicad/**",
      "tools/**"
    ],
    "hardware-validation": [
      "cad/**",
      "kicad/**",
      "firmware/**",
      "docs/**"
    ]
  },
  "validationCommands": [],
  "disabledSkills": [],
  "requireVisualEvidence": true,
  "sections": {
    "Problem": "Problem",
    "Behavior": "Behavior",
    "Validation": "Validation",
    "Risks": "Risks",
    "visual": "Visual evidence",
    "size": "Size exception"
  }
}
